<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Hotel Booking System</title>

    <link href="assets/css/darkpan.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <h2><i class="fas fa-hotel"></i> DarkPan</h2>
        </div>
        <nav>
            <ul>
                <li>
                    <a href="index.html" class="active">
                        <i class="fas fa-home"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="Guest.aspx">
                        <i class="fas fa-users"></i>
                        <span>Guests</span>
                    </a>
                </li>
                <li>
                    <a href="Reservations.aspx">
                        <i class="fas fa-calendar-check"></i>
                        <span>Reservations</span>
                    </a>
                </li>
                <li>
                    <a href="Rooms.aspx">
                        <i class="fas fa-bed"></i>
                        <span>Rooms</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-chart-bar"></i>
                        <span>Reports</span>
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fas fa-cog"></i>
                        <span>Settings</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <div class="top-nav">
            <div class="menu-toggle">
                <i class="fas fa-bars"></i>
            </div>
            <div class="search-box">
                <input type="text" placeholder="Search..." />
            </div>
            <div class="user-info">
                <i class="fas fa-bell" style="font-size: 20px; cursor: pointer;"></i>
                <i class="fas fa-envelope" style="font-size: 20px; cursor: pointer;"></i>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-user-circle" style="font-size: 32px;"></i>
                    <span>Admin</span>
                </div>
            </div>
        </div>

        <!-- Content Area - Empty as requested -->
        <div class="content-area">
            <!-- Empty content -->
        </div>

        <!-- Footer -->
        <div style="padding: 20px 30px; text-align: center; color: #B1B1B1; border-top: 1px solid #2C3E50; margin-top: 40px;">
            <p>&copy; 2024 Hotel Booking System - DarkPan Dashboard. All rights reserved.</p>
        </div>
    </div>

    <script src="assets/js/darkpan.js"></script>
</body>
</html>
